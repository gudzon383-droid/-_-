Функция СформироватьТелоЗапроса(НазваниеТовара)

	Инструкция = СтрШаблон("Ты маркетолог компании по продаже автомобильных изделий. Всегда отвечай на русском языке");
	Вхождение = СтрШаблон("Дай торговое описание товара: %1", НазваниеТовара);
	ОписаниеЗапроса = Новый Структура;
	ОписаниеЗапроса.Вставить("model","gpt://b1guegbsiolnil4s2uoa/aliceai-llm/latest");
	ОписаниеЗапроса.Вставить("instructions", Инструкция);
	ОписаниеЗапроса.Вставить("input", Вхождение);
	ОписаниеЗапроса.Вставить("temperature",0.3);
	ОписаниеЗапроса.Вставить("max_output_tokens",500);
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, ОписаниеЗапроса);
	
	Результат = ЗаписьJSON.Закрыть();
	
	Возврат Результат;
		
КонецФункции

