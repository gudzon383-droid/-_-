// Получает описание товара из Mistral
//
// Параметры:
//  НазваниеТовара - Строка - название товара, для которого нужно получить описание
//
// Возвращаемое значение:
//  Строка - описание товара
Асинх Функция ПолучитьОписаниеТовара(НазваниеТовара) Экспорт

	Если Не ЗначениеЗаполнено(НазваниеТовара) Тогда
		Возврат "";
	КонецЕсли;
	
	Ключ = ОбщегоНазначенияМПВызовСервера.ПолучитьЗначениеКонстанты("MistralAPIКлюч");
	
	Если НЕ ЗначениеЗаполнено(Ключ)  Тогда
		ПоказатьПредупреждение(, "Не заполнен API ключ доступа к ИИ");
		Возврат "";
	КонецЕсли;
	 
	ТелоЗапросаJSON = СформироватьТелоЗапроса(НазваниеТовара);
	
	Если ЗначениеЗаполнено(ТелоЗапросаJSON) Тогда
		Запрос = Новый HTTPЗапрос();
		Запрос.АдресРесурса = "/v1/responses";
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.Заголовки.Вставить("Authorization", СтрШаблон("Api-Key %1", Ключ));
		Запрос.Заголовки.Вставить("OpenAI-Project", "b1guegbsiolnil4s2uoa");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапросаJSON);
		Соединение = Новый HTTPСоединение("ai.api.cloud.yandex.net", 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();
			ЧтениеJSON = Новый ЧтениеJSON();
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
			Если ДанныеОтвета.Свойство("output") И ДанныеОтвета.output.Количество() > 0 Тогда
				Возврат ДанныеОтвета.output[0].content[0].text;
			Иначе
				ПоказатьПредупреждение(, "Не удалось корректно сформировать запрос к серверу", ,"Ошибка");
			КонецЕсли; 
		Иначе
			ПоказатьПредупреждение(, Ответ.ПолучитьТелоКакСтроку(), ,"Ошибка");
			Возврат "";
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, "Не удалось сформировать запрос к сервису", );
		Возврат "";
	КонецЕсли;
 
КонецФункции

